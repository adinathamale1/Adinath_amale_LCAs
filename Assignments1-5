# Assignment-1 Write a python program to create, append and remove etc. operation on Dictionary and Tuple. 

#for dictionary
student = {
    "name": "Adinath",
    "age": 17,
    "course": "Engineering"
}
print("Original Dictionary:", student)

student.update({"city": "Pune"})
print("After adding:", student)

student.pop("age")
print("After removing:", student)

student = dict(reversed(list(student.items())))
print("Reversed Dictionary:", student)

print("Count of Pune:", list(student.values()).count("Pune"))

#for tuples
numbers = (10, 20, 30, 40, 50)
print("Original Tuple:", numbers)

numbers = numbers + (60,)
print("After adding:", numbers)

numbers = numbers[:2] + numbers[3:]
print("After removing 30:", numbers)

numbers = numbers[::-1]
print("Reversed Tuple:", numbers)

print("Count of 20:", numbers.count(20))


