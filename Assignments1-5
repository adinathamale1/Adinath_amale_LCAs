# Assignment-5 Write a Python program to check that a string contains only a certain set of characters (in this case a-z, A-Z and 0-9). 
import re

string = input("Enter a string: ")

if re.fullmatch("[a-zA-Z0-9]+", string):
    print("String contains only a-z, A-Z and 0-9.")
else:
    print("String contains other characters.")
