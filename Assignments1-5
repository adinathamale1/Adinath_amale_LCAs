# Assignment-3 Write a Python program that accepts the length of three sides of a triangle as inputs. The program should indicate whether or not the triangle is a right-angled triangle using function.
def right_triangle(a, b, c):
    if a >= b and a >= c:
        largest = a
        x = b
        y = c
    elif b >= a and b >= c:
        largest = b
        x = a
        y = c
    else:
        largest = c
        x = a
        y = b

    if largest ** 2 == x ** 2 + y ** 2:
        return True
    else:
        return False


a = int(input("Enter first side: "))
b = int(input("Enter second side: "))
c = int(input("Enter third side: "))

if right_triangle(a, b, c):
    print("The triangle is a right-angled triangle.")
else:
    print("The triangle is not a right-angled triangle.")


# Assignment-4 Write a Python program to create an array and perform addition of two matrices. 
# addition of matrices using lists
A = [
    [1, 2],
    [3, 4]
]

B = [
    [5, 6],
    [7, 8]
]

C = [
    [0, 0],
    [0, 0]
]

for i in range(2):
    for j in range(2):
        C[i][j] = A[i][j] + B[i][j]

print("Matrix A:")
for row in A:
    print(row)

print("Matrix B:")
for row in B:
    print(row)

print("Addition of matrices:")
for row in C:
    print(row)

